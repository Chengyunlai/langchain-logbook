# LangChain API Key Configuration
# Copy this file to .env and fill in the blanks

# OpenAI API Key (if needed)
# OPENAI_API_KEY=sk-...

# DeepSeek API Key (recommended)
# DEEPSEEK_API_KEY=...

# Bailian / DashScope compatible API (optional RAG integration profile)
# BAILIAN_API_KEY=...

# Core tests force the offline profile and never require a paid API.
# `make test-integration` switches this to integration for the subprocess.
# LANGCHAIN_LOGBOOK_PROFILE=offline

# LangChain Trace (for LangSmith)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=...
# LANGCHAIN_PROJECT=langchain-logbook

# Search engine ownership verification (optional, used by the docs site)
# PUBLIC_GOOGLE_SITE_VERIFICATION=
# PUBLIC_BING_SITE_VERIFICATION=
# PUBLIC_BAIDU_SITE_VERIFICATION=

# Do not store runtime identity, permissions, or secrets in Graph State.
